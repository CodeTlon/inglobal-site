{
  "name": "inglobal-site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:video": "node scripts/optimize-video.mjs",
    "prebuild": "node scripts/optimize-images.mjs && node scripts/optimize-video.mjs",
    "db:up": "docker compose -p inglobal-propio up -d",
    "db:down": "docker compose -p inglobal-propio down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local:setup": "npm run db:migrate && node --import tsx scripts/db-local-seed.ts",
    "db:local:reset": "node --import tsx scripts/db-local-seed.ts --reset",
    "db:import-prod": "tsx scripts/migracion/importar-prod.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "^3.3.18",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.12",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-youtube": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.8.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.72.1",
    "resend": "6.33.0",
    "sanitize-html": "^2.17.7",
    "sharp": "0.35.5",
    "slugify": "^1.6.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
