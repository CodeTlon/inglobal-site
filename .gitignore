# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# services/* tiene su propio package.json/node_modules (ver services/video-transcode) —
# sin esto, node_modules ahí quedaba sin ignorar (el patrón de arriba está anclado a la raíz).
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings (per-user)
.claude/settings.local.json

# local artifacts (lighthouse reports, page snapshots)
lighthouse-report.json
www.gruasinglobal.com-*.html

# playwright
/playwright-report/
/test-results/

# videos crudos sin optimizar (pesan cualquier cosa) — solo se commitea
# el output de `npm run optimize:video` en public/videos/opt/
/public/videos/*
!/public/videos/opt/
.env*
