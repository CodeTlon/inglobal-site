# Backend propio en local (docker compose up -d). Copiar a .env.local para trabajar contra esta base.
DATABASE_URL=postgres://inglobal:inglobal@127.0.0.1:41510/inglobal
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-aleatorio-local
BETTER_AUTH_URL=http://localhost:3000
S3_ENDPOINT=http://127.0.0.1:41511
S3_BUCKET=media
S3_ACCESS_KEY_ID=inglobal
S3_SECRET_ACCESS_KEY=inglobal-secret
S3_REGION=us-east-1
STORAGE_PUBLIC_URL=http://127.0.0.1:41511/media
