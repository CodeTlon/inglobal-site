# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email del form de contacto)
# --- MODO PRUEBA (sin dominio verificado) ---
# Dejá RESEND_FROM_EMAIL en blanco: usa onboarding@resend.dev (sandbox de Resend).
# En sandbox Resend SOLO entrega al mail con el que te registraste:
# poné ese mail en COMPANY_EMAIL para que te lleguen las consultas de prueba.
RESEND_API_KEY=
RESEND_FROM_NAME=Grúas InGlobal
RESEND_FROM_EMAIL=

# --- PRODUCCIÓN (cuando se verifique gruasinglobal.com en Resend) ---
# RESEND_FROM_EMAIL=info@gruasinglobal.com
# COMPANY_EMAIL=info@gruasinglobal.com

# Empresa
COMPANY_EMAIL=info@gruasinglobal.com

# Servicio de transcode de video (services/video-transcode, deployado aparte en Coolify)
# Sin esto, el upload de video del dashboard sube el archivo tal cual, sin comprimir.
NEXT_PUBLIC_TRANSCODE_SERVICE_URL=
TRANSCODE_SHARED_SECRET=

# Cron de agenda (ver vercel.json) — Vercel manda este secreto en el header
# Authorization de cada invocación programada. Generar un valor random
# (ej. `openssl rand -hex 32`) y setearlo en Vercel > proyecto > Settings >
# Environment Variables. Sin esto el cron responde 401 y no hace nada.
CRON_SECRET=
