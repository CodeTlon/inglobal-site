# Base de datos (Postgres)
DATABASE_URL=postgres://usuario:clave@host:5432/inglobal
# DATABASE_SSL=require        # si la base exige SSL
# DATABASE_POOL_MAX=5

# Auth (Better Auth)
BETTER_AUTH_SECRET=           # openssl rand -base64 32 (distinto por entorno)
BETTER_AUTH_URL=http://localhost:3000   # URL pública del sitio
# BETTER_AUTH_TRUSTED_ORIGINS=https://gruasinglobal.com   # CSV, si hay otros orígenes (p. ej. la app)

# Archivos (S3-compatible: MinIO en Coolify o R2)
S3_ENDPOINT=
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
STORAGE_PUBLIC_URL=           # base pública del bucket, sin barra final (también como build arg del Dockerfile)

# Cron (GitHub Actions) y servicios
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# NEXT_PUBLIC_TRANSCODE_SERVICE_URL=
# TRANSCODE_SHARED_SECRET=
