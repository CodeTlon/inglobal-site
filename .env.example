# Base de datos (Postgres)
DATABASE_URL=postgres://usuario:clave@host:5432/inglobal
# DATABASE_SSL=require        # si la base exige SSL
# DATABASE_POOL_MAX=5

# Auth (Better Auth)
BETTER_AUTH_SECRET=           # openssl rand -base64 32 (distinto por entorno)
BETTER_AUTH_URL=http://localhost:3000   # URL pública del sitio
# BETTER_AUTH_TRUSTED_ORIGINS=https://gruasinglobal.com   # CSV, si hay otros orígenes

# Archivos subidos. Con el docker-compose de Coolify: STORAGE_DIR (volumen) y la URL pública /media.
STORAGE_DIR=/data/storage
STORAGE_PUBLIC_URL=http://localhost:3000/media   # sin barra final; también como build arg del Dockerfile
# Alternativa con bucket S3-compatible (R2/MinIO): dejar STORAGE_DIR vacío y completar
# S3_ENDPOINT= S3_BUCKET=media S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_REGION=us-east-1

# Build (NEXT_PUBLIC_*: entran en el build)
NEXT_PUBLIC_SITE_URL=         # vacío = https://gruasinglobal.com
NEXT_PUBLIC_GA_ID=

# Crons de agenda y notificaciones (los dispara el servicio `cron` del compose)
CRON_SECRET=

# Mail del formulario de contacto (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=
COMPANY_EMAIL=

# Servicio global de compresión de video (opcional: sin él, el video se guarda sin comprimir)
# TRANSCODE_SERVICE_URL=https://video.tu-dominio.com
# TRANSCODE_API_KEY=
